{
  "name": "kaffettino-api",
  "version": "1.0.0",
  "description": "API server which serves all functions of Kaffettino Rebrewed, a new version of VivereKaffettino made by Antonio Murabito and Daniele Susino.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "bun --watch run ./src/server.ts",
    "start": "bun run ./src/server.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "kaffettino-api"
  ],
  "author": "murabito.eu",
  "license": "MIT",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/middie": "^9.0.3",
    "@fastify/swagger": "^9.6.1",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.0.1",
    "better-auth": "^1.3.34",
    "fastify": "^5.6.1",
    "fastify-better-auth": "^1.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^2.1.6",
    "@vitest/ui": "^2.1.6",
    "prisma": "^7.0.1",
    "tsconfig-paths": "^4.2.0",
    "vite": "^6.0.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.6"
  }
}
