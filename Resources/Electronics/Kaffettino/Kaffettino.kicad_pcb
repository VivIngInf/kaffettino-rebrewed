	(gr_text "{dblquote}Facciamo un kaffettino?\nÈ l'ora del kaffettino!\nNon dovrei, ne ho bevuti un casino!\nMa io voglio seguire il mio cuoricino...\nVAIIIIII!{dblquote}\n- Pupetti Tutti Matti"
		(at 151.5212 151.7412 0)
		(layer "B.SilkS")
		(uuid "b6185458-edbc-4687-8b9f-5d81a30b9a97")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "Did I ever tell you what the definition of insanity is?\nInsanity is doing the exact... \nsame fucking thing... \nover and over again expecting...\nshit to change...\nThat. Is. Crazy.\nDid I ever tell you what the definition of insanity is?"
		(at 79.8932 70.766343 0)
		(layer "B.SilkS")
		(uuid "bc6322ba-0ec6-461e-b78e-10b6b2f466e5")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom mirror)
		)
	)
